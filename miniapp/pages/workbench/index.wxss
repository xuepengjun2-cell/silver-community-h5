.subtitle { margin: 18rpx 0 30rpx; }
.tabs { display: flex; gap: 12rpx; margin: 26rpx 0; }
.tab { flex: 1; font-size: 27rpx; padding: 24rpx 7rpx; text-align: center; background: #f1e9df; border-radius: 14rpx; }
.tab.active { background: #ba512e; color: #fff; font-weight: 700; }
.section-header { display: flex; align-items: center; justify-content: space-between; gap: 15rpx; margin: 28rpx 0; }
.section-title { font-size: 34rpx; font-weight: 700; }
.add { min-height: 72rpx; font-size: 28rpx; padding: 10rpx 20rpx; flex-shrink: 0; }
.create { padding: 26rpx; margin: 24rpx 0; }
.field { width: 100%; height: 86rpx; padding: 16rpx; border: 1rpx solid #dfd1c7; border-radius: 14rpx; margin-top: 18rpx; background: #fff; font-size: 30rpx; }
.picker { color: #61584e; }
.description { height: 150rpx; }
.create-actions, .item-actions { display: flex; gap: 14rpx; margin-top: 18rpx; }
.create-actions .button, .item-actions .button { flex: 1; min-height: 76rpx; font-size: 28rpx; }
.item { overflow: hidden; margin-bottom: 20rpx; }
.thumb { width: 100%; height: 250rpx; }
.item-main { padding: 22rpx 24rpx 0; }
.item-title { font-size: 34rpx; font-weight: 700; line-height: 1.4; }
.item-main .muted { margin-top: 12rpx; }
.item-actions { padding: 0 24rpx 24rpx; }
.catalog-heading { margin: 28rpx 0; }
.catalog { padding: 24rpx; margin-bottom: 18rpx; }
.catalog .muted { margin-top: 10rpx; }
.logout { margin: 48rpx auto; color: #906354; background: none; font-size: 28rpx; }
