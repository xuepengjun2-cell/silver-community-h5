.entry-page { padding-top: 92rpx; }
.entry-lead { margin: 28rpx 0 50rpx; }
.entry-remember { margin: -28rpx 0 28rpx; font-size: 26rpx; }
.entry-card { padding: 32rpx; }
.entry-card-title { font-size: 35rpx; font-weight: 700; margin-bottom: 24rpx; }
.entry-wechat { margin-bottom: 26rpx; }
.entry-wechat-section { padding-top: 8rpx; margin-top: 28rpx; border-top: 1rpx solid #eee4dc; }
.entry-text-button { margin-top: 18rpx; padding: 8rpx; background: transparent; color: #72584b; font-size: 27rpx; }
.entry-text-button::after { border: none; }
.entry-guest { margin: 0 0 28rpx; }
.entry-label { font-size: 30rpx; font-weight: 650; margin: 22rpx 0 12rpx; }
.entry-field { width: 100%; height: 96rpx; padding: 0 22rpx; border: 1rpx solid #dfd1c7; border-radius: 16rpx; background: #fff; font-size: 32rpx; }
.entry-open { margin-top: 36rpx; }
.entry-error { color: #b42318; font-size: 28rpx; margin-top: 18rpx; }
.entry-notice { margin-top: 36rpx; }
.entry-state { padding: 22rpx; margin-bottom: 26rpx; border-radius: 14rpx; background: #fff3e8; color: #7b3e28; font-size: 28rpx; line-height: 1.5; }
.entry-secondary { width: 100%; margin-top: 20rpx; padding: 12rpx; background: #fff; color: #b94f28; border: 1rpx solid #d8b6a5; border-radius: 14rpx; font-size: 29rpx; }
.entry-apply { margin-top: 22rpx; }
.entry-privacy { margin-top: 20rpx; font-size: 25rpx; }
.entry-consent { display: block; margin-top: 18rpx; font-size: 26rpx; line-height: 1.5; }
.entry-privacy-link { margin: 8rpx 0 0; padding: 0; text-align: left; color: #a54824; background: none; font-size: 25rpx; }
