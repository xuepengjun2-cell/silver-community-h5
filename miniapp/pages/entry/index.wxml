<view class="page entry-page">
  <view class="eyebrow">开开华彩 · 活动工作台</view>
  <view class="title">账号登录</view>
  <view class="muted entry-lead">使用原 H5 账号登录，系统会按账号权限展示可用内容。</view>
  <view wx:if="{{loading}}" class="state">正在检查登录状态…</view>
  <view wx:else class="card entry-card">
    <view class="entry-card-title">进入活动工作台</view>
    <view class="entry-label">账号</view>
    <input class="entry-field" value="{{username}}" bindinput="onUser" placeholder="请输入账号" maxlength="80"/>
    <view class="entry-label">密码</view>
    <input class="entry-field" value="{{password}}" bindinput="onPassword" placeholder="请输入密码" password="true"/>
    <view wx:if="{{error}}" class="entry-error">{{error}}</view>
    <button class="button button-primary entry-open" loading="{{busy}}" disabled="{{busy}}" bindtap="onSubmit">登录并进入</button>
  </view>
  <view class="notice entry-notice">客户从分享卡片直接进入对应相册，不经过本登录页；符合交付格式的照片和视频可免登录保存。</view>
</view>
