.meta { margin: 18rpx 0 28rpx; }
.summary { display: flex; justify-content: space-around; padding: 28rpx 8rpx; text-align: center; font-size: 27rpx; }
.summary strong { display: block; color: #ac482a; font-size: 35rpx; }
.actions { display: flex; gap: 14rpx; margin-top: 28rpx; }
.actions .button { flex: 1; font-size: 30rpx; }
.progress { margin-top: 22rpx; }
.hint { margin: 24rpx 0; }
.share, .view { margin-top: 18rpx; }
.section-title { margin: 48rpx 0 22rpx; font-weight: 700; font-size: 36rpx; }
.edit { padding: 26rpx; }
.field { width: 100%; height: 88rpx; border: 1rpx solid #dfd1c7; border-radius: 14rpx; padding: 15rpx; margin-bottom: 15rpx; }
.picker { color: #61584e; }
.description { height: 150rpx; }
.tile { display: flex; overflow: hidden; margin-bottom: 20rpx; }
.tile-cover, .tile-video { width: 200rpx; height: 200rpx; flex-shrink: 0; background: #ebe3db; }
.tile-video { display: flex; justify-content: center; align-items: center; }
.tile-details { padding: 22rpx; min-width: 0; }
.tile-name { font-size: 30rpx; overflow-wrap: anywhere; }
.remove { color: #ad321d; background: transparent; font-size: 27rpx; margin: 18rpx 0 0; padding: 0; text-align: left; }
.delete-project { margin: 40rpx 0 20rpx; border-color: #c83e31; color: #b23226; }
