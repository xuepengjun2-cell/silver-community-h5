<view class="page album-page">
  <view wx:if="{{loading}}" class="state">正在打开照片相册…</view>
  <view wx:elif="{{error}}" class="state">
    <view class="state-title">暂时看不到这个相册</view>
    <view class="muted">{{error}}</view>
    <button class="button button-secondary retry" bindtap="onRetry">重新加载</button>
  </view>
  <block wx:else>
    <image wx:if="{{cover}}" class="cover" src="{{cover}}" mode="aspectFill"/>
    <view wx:else class="cover cover-empty">照片相册</view>
    <view class="eyebrow album-eyebrow">美好时光 · 一起珍藏</view>
    <view class="title">{{project.title}}</view>
    <view class="muted album-meta">{{project.dateLabel || '活动回忆'}}{{project.city ? ' · ' + project.city : ''}}</view>
    <view wx:if="{{project.description}}" class="album-description">{{project.description}}</view>
    <view class="album-actions">
      <button class="button button-primary" open-type="share">分享照片相册</button>
    </view>
    <view class="photo-count">照片 {{imageCount}}</view>
    <view wx:if="{{tiles.length}}" class="media-grid">
      <view wx:for="{{tiles}}" wx:key="index" class="media-tile card" data-index="{{item.index}}" bindtap="onMedia">
        <image class="tile-image" src="{{item.imageUrl}}" mode="aspectFill" lazy-load="true"/>
        <view class="tile-name">{{item.name}}</view>
      </view>
    </view>
    <view wx:else class="state">这个相册暂时没有可查看的 JPG 或 PNG 照片</view>
    <view class="notice album-note">点开照片后，可将 JPG 或 PNG 保存到手机相册，不需要登录。</view>
  </block>
</view>
