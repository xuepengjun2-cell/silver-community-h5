.album-page { padding-top: 0; }
.cover { display: flex; align-items: center; justify-content: center; width: calc(100% + 64rpx); height: 420rpx; margin: 0 -32rpx 36rpx; background: #c28566; color: #fff; }
.album-eyebrow { margin-top: 14rpx; }
.album-meta { margin-top: 18rpx; }
.album-description { font-size: 31rpx; line-height: 1.6; margin-top: 22rpx; white-space: pre-wrap; }
.album-actions { margin: 32rpx 0; }
.photo-count { margin: 40rpx 0 28rpx; font-size: 29rpx; font-weight: 700; }
.media-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; }
.media-tile { position: relative; overflow: hidden; }
.tile-image { width: 100%; height: 250rpx; }
.tile-name { padding: 18rpx; font-size: 27rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.album-note { margin-top: 40rpx; }
.retry { margin-top: 32rpx; }
