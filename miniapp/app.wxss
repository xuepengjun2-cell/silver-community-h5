page {
  box-sizing: border-box;
  min-height: 100%;
  background: #fffaf4;
  color: #29251f;
  font-size: 34rpx;
}
button { box-sizing: border-box; }
view, button, input, image, video { box-sizing: border-box; }
.page { min-height: 100vh; padding: 36rpx 32rpx calc(64rpx + env(safe-area-inset-bottom)); }
.eyebrow { color: #ae4c2c; font-size: 27rpx; font-weight: 700; letter-spacing: 3rpx; }
.title { font-size: 46rpx; font-weight: 750; line-height: 1.3; margin-top: 16rpx; }
.muted { color: #756f68; font-size: 29rpx; line-height: 1.55; }
.card { background: #fff; border: 1rpx solid #e9dfd5; border-radius: 24rpx; box-shadow: 0 8rpx 20rpx rgba(51, 28, 17, .05); }
.button { min-height: 94rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 34rpx; font-weight: 650; padding: 16rpx 22rpx; line-height: 1.35; }
.button::after { border: 0; }
.button-primary { color: #fff; background: #ba512e; }
.button-secondary { color: #9d4229; background: #fff; border: 2rpx solid #d9b3a4; }
.button-disabled { color: #736e69; background: #e9e5e1; }
.notice { padding: 26rpx; border-radius: 20rpx; color: #674a39; background: #fff0df; font-size: 29rpx; line-height: 1.55; }
.state { margin: 76rpx 0; text-align: center; line-height: 1.6; color: #70675e; }
.state-title { color: #29251f; font-size: 38rpx; font-weight: 700; }
